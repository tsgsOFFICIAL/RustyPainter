<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <MergeResourceInclude Source="/Theme/Colors.Shared.axaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Light and dark have a palette each. Default, which follows Windows, is resolved by Avalonia to one of them. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceInclude Source="avares://RustyPainter/Theme/Colors.Light.axaml" x:Key="Light"/>
        <ResourceInclude Source="avares://RustyPainter/Theme/Colors.Dark.axaml" x:Key="Dark"/>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
