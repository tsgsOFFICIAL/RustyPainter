<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="TextColor"              Color="#F0F2F7"/>
    <SolidColorBrush x:Key="TextMutedColor"         Color="#8B92A5"/>
    <SolidColorBrush x:Key="BgColor"                Color="#111318"/>
    <SolidColorBrush x:Key="BorderColor"            Color="#2E3340"/>
    <SolidColorBrush x:Key="BorderColorTransparent" Color="#002E3340"/>
    <SolidColorBrush x:Key="BorderColorMuted"       Color="#4D2E3340"/>
    <!-- AccentColor (#F97316) at 15% alpha (#26), pre-blended opaque over this theme's BgColor
         (#111318): result = alpha*fg + (1-alpha)*bg per channel, alpha = 0x26/255 = 0.14902.
         R: 0.14902*249 + 0.85098*17  = 51.57 -> 0x34
         G: 0.14902*115 + 0.85098*19  = 33.31 -> 0x21
         B: 0.14902*22  + 0.85098*24  = 23.70 -> 0x18
         Kept opaque (alpha=255) so BrushTransition, which interpolates ARGB channels
         independently, never has to ramp alpha and hue at once - see AppStyles.axaml's
         Button.navItem.active for why that combination flashes. Recompute this if
         AccentColor or this theme's BgColor ever change. -->
    <SolidColorBrush x:Key="AccentSurfaceColor"     Color="#342118"/>

    <!-- Text boxes: the Fluent theme reads these, so they follow the app colors instead of the Windows accent. -->
    <SolidColorBrush x:Key="TextControlBackground"                 Color="#111318"/>
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver"      Color="#111318"/>
    <SolidColorBrush x:Key="TextControlBackgroundFocused"          Color="#111318"/>
    <SolidColorBrush x:Key="TextControlBorderBrush"                Color="#2E3340"/>
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver"     Color="#8B92A5"/>
    <SolidColorBrush x:Key="TextControlBorderBrushFocused"         Color="#F97316"/>
    <SolidColorBrush x:Key="TextControlForeground"                 Color="#F0F2F7"/>
    <SolidColorBrush x:Key="TextControlForegroundPointerOver"      Color="#F0F2F7"/>
    <SolidColorBrush x:Key="TextControlForegroundFocused"          Color="#F0F2F7"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForeground"      Color="#8B92A5"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#8B92A5"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#8B92A5"/>

    <!-- Check boxes in the app accent. -->
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked"            Color="#F97316"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#FB923C"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed"     Color="#FB923C"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked"          Color="#F97316"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#FB923C"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed"   Color="#FB923C"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked"        Color="#8B92A5"/>
</ResourceDictionary>