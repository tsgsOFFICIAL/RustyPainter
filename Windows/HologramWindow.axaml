<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RustyPainter.Windows.HologramWindow"
        Title="RustyPainter hologram"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        CanResize="False"
        Focusable="False"
        IsHitTestVisible="False"
        WindowStartupLocation="Manual">

    <Image x:Name="Picture" Stretch="Fill" RenderOptions.BitmapInterpolationMode="None"/>

</Window>
