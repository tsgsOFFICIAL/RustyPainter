<Window xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:RustyPainter.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:RustyPainter.ViewModels"
        xmlns:views="using:RustyPainter.Views"
        xmlns:controls="using:RustyPainter.Controls"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="520"
        x:Class="RustyPainter.Windows.UpdateAvailableWindow"
        x:DataType="vm:UpdateAvailableViewModel"
        Title="{loc:L UpdateAvailableTitle}"
        Icon="/Assets/App/logo.ico"
        Width="480" Height="520"
        MinWidth="420" MinHeight="360"
        Background="{DynamicResource BgColor}"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="{DynamicResource DangerColor}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <controls:TitleBar Grid.Row="0"
                           Title="{loc:L UpdateAvailableTitle}"
                           Author="tsgsOFFICIAL"
                           ShowMaximizeButton="False">
            <controls:TitleBar.Icon>
                <Image Source="/Assets/App/logo.ico"/>
            </controls:TitleBar.Icon>
        </controls:TitleBar>

        <views:UpdateAvailableView Grid.Row="1"/>

        <Border Grid.Row="2"
                Padding="16"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,1,0,0">
            <StackPanel Spacing="12">
                <ProgressBar Classes="thinBar"
                             IsVisible="{Binding IsBusy}"
                             Minimum="0" Maximum="100"
                             Value="{Binding ProgressPercent}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Foreground="{DynamicResource AccentColor}"/>

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusText}"
                               IsVisible="{Binding IsStatusVisible}"
                               Classes="muted"
                               Classes.error="{Binding IsFailed}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="{loc:L Later}"
                                Command="{Binding LaterCommand}"/>
                        <Button Content="{Binding UpdateButtonText}"
                                Classes="accentButton"
                                Command="{Binding UpdateNowCommand}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

    </Grid>

</Window>
