<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:RustyPainter.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             xmlns:avconverters="using:Avalonia.Data.Converters"
             xmlns:vm="using:RustyPainter.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="RustyPainter.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Resources>
        <!-- Sliders in the app accent instead of the Windows accent. -->
        <StaticResource x:Key="SliderTrackValueFill" ResourceKey="AccentColor"/>
        <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="AccentColorHover"/>
        <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="AccentColorHover"/>
        <StaticResource x:Key="SliderThumbBackground" ResourceKey="AccentColor"/>
        <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="AccentColorHover"/>
        <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="AccentColorHover"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
        <Style Selector="TextBlock.sectionSubtitle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedColor}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style Selector="TextBlock.settingLabel">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
        <Style Selector="TextBlock.settingDescription">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedColor}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style Selector="Border.settingRow">
            <Setter Property="Padding" Value="0,14"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="24" MaxWidth="820" HorizontalAlignment="Left">

            <StackPanel Spacing="4">
                <TextBlock Text="{loc:L NavSettings}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextColor}"/>
                <TextBlock Text="{loc:L SettingsSubtitle}" Classes="muted"/>
            </StackPanel>

            <!-- Appearance and language -->
            <Border Classes="card">
                <StackPanel Spacing="0">
                    <StackPanel Spacing="0" Margin="0,0,0,4">
                        <TextBlock Text="{loc:L SettingsAppearance}" Classes="sectionTitle"/>
                        <TextBlock Text="{loc:L SettingsAppearanceSubtitle}" Classes="sectionSubtitle"/>
                    </StackPanel>

                    <Border Classes="settingRow" Margin="0,10,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:L SettingsTheme}" Classes="settingLabel"/>
                                <TextBlock Text="{loc:L SettingsThemeDescription}" Classes="settingDescription"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" VerticalAlignment="Center" MinWidth="160"
                                      ItemsSource="{Binding ThemeOptions}"
                                      SelectedItem="{Binding SelectedTheme}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ThemeOption">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:L SettingsLanguage}" Classes="settingLabel"/>
                                <TextBlock Text="{loc:L SettingsLanguageDescription}" Classes="settingDescription"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" VerticalAlignment="Center" MinWidth="160"
                                      ItemsSource="{Binding LanguageOptions}"
                                      SelectedItem="{Binding SelectedLanguage}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LanguageOption">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Image Source="{Binding Flag}" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Updates -->
            <Border Classes="card">
                <StackPanel Spacing="0">
                    <StackPanel Spacing="0" Margin="0,0,0,4">
                        <TextBlock Text="{loc:L SettingsUpdates}" Classes="sectionTitle"/>
                        <TextBlock Text="{Binding RunningVersionText}" Classes="sectionSubtitle"/>
                    </StackPanel>

                    <Border Classes="settingRow" Margin="0,10,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:L SettingsCheckOnStartup}" Classes="settingLabel"/>
                                <TextBlock Text="{loc:L SettingsCheckOnStartupDescription}" Classes="settingDescription"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent=""
                                          IsChecked="{Binding CheckForUpdatesOnStartup}"/>
                        </Grid>
                    </Border>

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:L SettingsAutoUpdate}" Classes="settingLabel"/>
                                <TextBlock Text="{loc:L SettingsAutoUpdateDescription}" Classes="settingDescription"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent=""
                                          IsEnabled="{Binding CanAutoUpdate}"
                                          IsChecked="{Binding AutoUpdate}"/>
                        </Grid>
                    </Border>

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:L SettingsCheckNow}" Classes="settingLabel"/>
                                <TextBlock Text="{Binding UpdateStatusText}"
                                           IsVisible="{Binding IsUpdateStatusVisible}"
                                           Classes="settingDescription"/>
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" Classes="secondaryButton"
                                    Command="{Binding CheckForUpdatesCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <iconPacks:PackIconPhosphorIcons Kind="ArrowsClockwise" Width="16" Height="16"/>
                                    <TextBlock Text="{loc:L SettingsCheckForUpdates}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Painting -->
            <Border Classes="card">
                <StackPanel Spacing="0">
                    <StackPanel Spacing="0" Margin="0,0,0,4">
                        <TextBlock Text="{loc:L SettingsPainting}" Classes="sectionTitle"/>
                        <TextBlock Text="{loc:L SettingsPaintingSubtitle}" Classes="sectionSubtitle"/>
                    </StackPanel>

                    <Border Classes="settingRow" Margin="0,10,0,0">
                        <StackPanel Spacing="2">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{loc:L Speed}" Classes="settingLabel"/>
                                    <TextBlock Text="{loc:L SettingsSpeedDescription}" Classes="settingDescription"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding PaintSpeedText}" VerticalAlignment="Center" FontSize="13"/>
                            </Grid>
                            <Slider Minimum="1" Maximum="100" Value="{Binding PaintSpeed}"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:L SettingsHologram}" Classes="settingLabel"/>
                                <TextBlock Text="{loc:L SettingsHologramDescription}" Classes="settingDescription"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent=""
                                          IsChecked="{Binding ShowHologram}"/>
                        </Grid>
                    </Border>

                    <Border Classes="settingRow">
                        <StackPanel Spacing="2">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{loc:L SettingsPictureStrength}" Classes="settingLabel"/>
                                    <TextBlock Text="{loc:L SettingsStrengthDescription}" Classes="settingDescription"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding HologramStrengthText}" VerticalAlignment="Center" FontSize="13"/>
                            </Grid>
                            <Slider Minimum="10" Maximum="90" Value="{Binding HologramStrength}"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:L SettingsStatusBox}" Classes="settingLabel"/>
                                <TextBlock Text="{loc:L SettingsStatusBoxDescription}" Classes="settingDescription"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent=""
                                          IsChecked="{Binding ShowStatusBox}"/>
                        </Grid>
                    </Border>

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:L SettingsBackToDefaults}" Classes="settingLabel"/>
                                <TextBlock Text="{loc:L SettingsResetPaintingDescription}" Classes="settingDescription"/>
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" Classes="secondaryButton" Command="{Binding ResetPaintingCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <iconPacks:PackIconPhosphorIcons Kind="ArrowCounterClockwise" Width="16" Height="16"/>
                                    <TextBlock Text="{loc:L SettingsResetPainting}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Painting keys -->
            <Border Classes="card">
                <StackPanel Spacing="0">
                    <StackPanel Spacing="0" Margin="0,0,0,4">
                        <TextBlock Text="{loc:L SettingsPaintingKeys}" Classes="sectionTitle"/>
                        <TextBlock Text="{loc:L SettingsKeysSubtitle}" Classes="sectionSubtitle"/>
                    </StackPanel>

                    <Border Classes="settingRow" Margin="0,10,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:L SettingsStartPauseKey}" Classes="settingLabel"/>
                                <TextBlock Text="{loc:L SettingsKeyCaptureHelp}" Classes="settingDescription"/>
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" Classes="secondaryButton" MinWidth="120"
                                    Command="{Binding CaptureStartPauseCommand}" LostFocus="OnCaptureLostFocus">
                                <TextBlock Text="{Binding StartPauseButtonText}" HorizontalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:L Stop}" Classes="settingLabel"/>
                                <TextBlock Text="{loc:L SettingsStopKeyDescription}" Classes="settingDescription"/>
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" Classes="secondaryButton" MinWidth="120"
                                    Command="{Binding CaptureAbortCommand}" LostFocus="OnCaptureLostFocus">
                                <TextBlock Text="{Binding AbortButtonText}" HorizontalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:L SettingsBackToDefaults}" Classes="settingLabel"/>
                                <TextBlock Text="{Binding HotkeyMessage}" IsVisible="{Binding HasHotkeyMessage}"
                                           Classes="settingDescription" Foreground="{DynamicResource DangerColor}"/>
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" Classes="secondaryButton"
                                    Command="{Binding ResetHotkeysCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <iconPacks:PackIconPhosphorIcons Kind="ArrowCounterClockwise" Width="16" Height="16"/>
                                    <TextBlock Text="{loc:L SettingsResetKeys}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Library -->
            <Border Classes="card">
                <StackPanel Spacing="0">
                    <StackPanel Spacing="0" Margin="0,0,0,4">
                        <TextBlock Text="{loc:L NavLibrary}" Classes="sectionTitle"/>
                        <TextBlock Text="{loc:L SettingsLibrarySubtitle}" Classes="sectionSubtitle"/>
                    </StackPanel>

                    <Border Classes="settingRow" Margin="0,10,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:L SettingsLibraryFolder}" Classes="settingLabel"/>
                                <TextBlock Text="{loc:L SettingsLibraryFolderDescription}" Classes="settingDescription"/>
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" Classes="secondaryButton" Command="{Binding OpenLibraryFolderCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <iconPacks:PackIconPhosphorIcons Kind="FolderOpen" Width="16" Height="16"/>
                                    <TextBlock Text="{loc:L OpenFolder}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Diagnostics -->
            <Border Classes="card">
                <StackPanel Spacing="0">
                    <StackPanel Spacing="0" Margin="0,0,0,4">
                        <TextBlock Text="{loc:L SettingsDiagnostics}" Classes="sectionTitle"/>
                        <TextBlock Text="{loc:L SettingsDiagnosticsSubtitle}" Classes="sectionSubtitle"/>
                    </StackPanel>

                    <Border Classes="settingRow" Margin="0,10,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:L SettingsVerbose}" Classes="settingLabel"/>
                                <TextBlock Text="{loc:L SettingsVerboseDescription}" Classes="settingDescription"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent=""
                                          IsChecked="{Binding VerboseLogging}"/>
                        </Grid>
                    </Border>

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:L SettingsLogFolder}" Classes="settingLabel"/>
                                <TextBlock Text="{loc:L SettingsLogFolderDescription}" Classes="settingDescription"/>
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" Classes="secondaryButton"
                                    Command="{Binding OpenLogsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <iconPacks:PackIconPhosphorIcons Kind="FolderOpen" Width="16" Height="16"/>
                                    <TextBlock Text="{loc:L OpenFolder}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
