<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             xmlns:avconverters="using:Avalonia.Data.Converters"
             xmlns:vm="using:RustyPainter.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="RustyPainter.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Resources>
        <!-- Sliders in the app accent instead of the Windows accent. -->
        <StaticResource x:Key="SliderTrackValueFill" ResourceKey="AccentColor"/>
        <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="AccentColorHover"/>
        <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="AccentColorHover"/>
        <StaticResource x:Key="SliderThumbBackground" ResourceKey="AccentColor"/>
        <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="AccentColorHover"/>
        <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="AccentColorHover"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
        <Style Selector="TextBlock.sectionSubtitle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedColor}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style Selector="TextBlock.settingLabel">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
        <Style Selector="TextBlock.settingDescription">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedColor}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style Selector="Border.settingRow">
            <Setter Property="Padding" Value="0,14"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="24" MaxWidth="820" HorizontalAlignment="Left">

            <StackPanel Spacing="4">
                <TextBlock Text="Settings" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextColor}"/>
                <TextBlock Text="Updates, painting, the Library and diagnostics." Classes="muted"/>
            </StackPanel>

            <!-- Updates -->
            <Border Classes="card">
                <StackPanel Spacing="0">
                    <StackPanel Spacing="0" Margin="0,0,0,4">
                        <TextBlock Text="Updates" Classes="sectionTitle"/>
                        <TextBlock Classes="sectionSubtitle">
                            <Run Text="You're running version"/>
                            <Run Text="{Binding VersionText}" FontWeight="Bold"/>
                        </TextBlock>
                    </StackPanel>

                    <Border Classes="settingRow" Margin="0,10,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Check for updates on startup" Classes="settingLabel"/>
                                <TextBlock Text="Looks for a newer release on GitHub each time the app opens." Classes="settingDescription"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent=""
                                          IsChecked="{Binding CheckForUpdatesOnStartup}"/>
                        </Grid>
                    </Border>

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Install updates automatically" Classes="settingLabel"/>
                                <TextBlock Text="Downloads and applies a new version without asking, then restarts the app. Needs the startup check." Classes="settingDescription"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent=""
                                          IsEnabled="{Binding CanAutoUpdate}"
                                          IsChecked="{Binding AutoUpdate}"/>
                        </Grid>
                    </Border>

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Check now" Classes="settingLabel"/>
                                <TextBlock Text="{Binding UpdateStatusText}"
                                           IsVisible="{Binding IsUpdateStatusVisible}"
                                           Classes="settingDescription"/>
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" Classes="secondaryButton"
                                    Command="{Binding CheckForUpdatesCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <iconPacks:PackIconPhosphorIcons Kind="ArrowsClockwise" Width="16" Height="16"/>
                                    <TextBlock Text="Check for updates"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Painting -->
            <Border Classes="card">
                <StackPanel Spacing="0">
                    <StackPanel Spacing="0" Margin="0,0,0,4">
                        <TextBlock Text="Painting" Classes="sectionTitle"/>
                        <TextBlock Text="How painting starts out. You can still change the speed and the picture on the get-ready page." Classes="sectionSubtitle"/>
                    </StackPanel>

                    <Border Classes="settingRow" Margin="0,10,0,0">
                        <StackPanel Spacing="2">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Speed" Classes="settingLabel"/>
                                    <TextBlock Text="Slower is more reliable. Lower it if the game misses clicks or letters." Classes="settingDescription"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding PaintSpeedText}" VerticalAlignment="Center" FontSize="13"/>
                            </Grid>
                            <Slider Minimum="1" Maximum="100" Value="{Binding PaintSpeed}"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Show the picture over the game" Classes="settingLabel"/>
                                <TextBlock Text="Draws the picture where it will be painted, on the get-ready page, so the position can be checked." Classes="settingDescription"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent=""
                                          IsChecked="{Binding ShowHologram}"/>
                        </Grid>
                    </Border>

                    <Border Classes="settingRow">
                        <StackPanel Spacing="2">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Picture strength" Classes="settingLabel"/>
                                    <TextBlock Text="How solid the picture over the game is." Classes="settingDescription"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding HologramStrengthText}" VerticalAlignment="Center" FontSize="13"/>
                            </Grid>
                            <Slider Minimum="10" Maximum="90" Value="{Binding HologramStrength}"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Show progress over the game" Classes="settingLabel"/>
                                <TextBlock Text="A small box at the top of the game with how far painting has come, so the app does not have to be in view." Classes="settingDescription"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent=""
                                          IsChecked="{Binding ShowStatusBox}"/>
                        </Grid>
                    </Border>

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Back to the defaults" Classes="settingLabel"/>
                                <TextBlock Text="Puts the speed, the picture, the progress box and the painting keys back as they were at the start." Classes="settingDescription"/>
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" Classes="secondaryButton" Command="{Binding ResetPaintingCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <iconPacks:PackIconPhosphorIcons Kind="ArrowCounterClockwise" Width="16" Height="16"/>
                                    <TextBlock Text="Reset painting"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Painting keys -->
            <Border Classes="card">
                <StackPanel Spacing="0">
                    <StackPanel Spacing="0" Margin="0,0,0,4">
                        <TextBlock Text="Painting keys" Classes="sectionTitle"/>
                        <TextBlock Text="These keys only work while Rust is the window in front. Every other program keeps its keys." Classes="sectionSubtitle"/>
                    </StackPanel>

                    <Border Classes="settingRow" Margin="0,10,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Start, pause and resume" Classes="settingLabel"/>
                                <TextBlock Text="Click the key, then press the one you want. Letters, numbers, function keys, Space and Esc work." Classes="settingDescription"/>
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" Classes="secondaryButton" MinWidth="120"
                                    Command="{Binding CaptureStartPauseCommand}" LostFocus="OnCaptureLostFocus">
                                <TextBlock Text="{Binding StartPauseButtonText}" HorizontalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Stop" Classes="settingLabel"/>
                                <TextBlock Text="Ends the painting for good. What is already painted stays on the canvas." Classes="settingDescription"/>
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" Classes="secondaryButton" MinWidth="120"
                                    Command="{Binding CaptureAbortCommand}" LostFocus="OnCaptureLostFocus">
                                <TextBlock Text="{Binding AbortButtonText}" HorizontalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Back to the defaults" Classes="settingLabel"/>
                                <TextBlock Text="{Binding HotkeyMessage}" IsVisible="{Binding HasHotkeyMessage}"
                                           Classes="settingDescription" Foreground="{DynamicResource DangerColor}"/>
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" Classes="secondaryButton"
                                    Command="{Binding ResetHotkeysCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <iconPacks:PackIconPhosphorIcons Kind="ArrowCounterClockwise" Width="16" Height="16"/>
                                    <TextBlock Text="Reset keys"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Library -->
            <Border Classes="card">
                <StackPanel Spacing="0">
                    <StackPanel Spacing="0" Margin="0,0,0,4">
                        <TextBlock Text="Library" Classes="sectionTitle"/>
                        <TextBlock Text="Saved projects are kept as ordinary folders, so they are easy to back up or move to another computer." Classes="sectionSubtitle"/>
                    </StackPanel>

                    <Border Classes="settingRow" Margin="0,10,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Library folder" Classes="settingLabel"/>
                                <TextBlock Text="Opens the folder where each project keeps its picture and settings." Classes="settingDescription"/>
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" Classes="secondaryButton" Command="{Binding OpenLibraryFolderCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <iconPacks:PackIconPhosphorIcons Kind="FolderOpen" Width="16" Height="16"/>
                                    <TextBlock Text="Open folder"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Diagnostics -->
            <Border Classes="card">
                <StackPanel Spacing="0">
                    <StackPanel Spacing="0" Margin="0,0,0,4">
                        <TextBlock Text="Diagnostics" Classes="sectionTitle"/>
                        <TextBlock Text="Log files help when something goes wrong." Classes="sectionSubtitle"/>
                    </StackPanel>

                    <Border Classes="settingRow" Margin="0,10,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Verbose logging" Classes="settingLabel"/>
                                <TextBlock Text="Also record debug-level detail. Turn this on when diagnosing a problem." Classes="settingDescription"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent=""
                                          IsChecked="{Binding VerboseLogging}"/>
                        </Grid>
                    </Border>

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Log folder" Classes="settingLabel"/>
                                <TextBlock Text="Opens the folder containing the daily log files." Classes="settingDescription"/>
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" Classes="secondaryButton"
                                    Command="{Binding OpenLogsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <iconPacks:PackIconPhosphorIcons Kind="FolderOpen" Width="16" Height="16"/>
                                    <TextBlock Text="Open folder"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
