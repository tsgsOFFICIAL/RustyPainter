<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:RustyPainter.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             xmlns:vm="using:RustyPainter.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="RustyPainter.Views.StudioView"
             x:DataType="vm:StudioViewModel"
             DragDrop.AllowDrop="True">

    <UserControl.Resources>
        <!-- Sliders in the app accent instead of the Windows accent. -->
        <StaticResource x:Key="SliderTrackValueFill" ResourceKey="AccentColor"/>
        <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="AccentColorHover"/>
        <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="AccentColorHover"/>
        <StaticResource x:Key="SliderThumbBackground" ResourceKey="AccentColor"/>
        <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="AccentColorHover"/>
        <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="AccentColorHover"/>

    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedColor}"/>
        </Style>

        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedColor}"/>
        </Style>

        <Style Selector="Button.small">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style Selector="ListBox.surfaceList">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.surfaceList ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="Background" Value="{DynamicResource BgColor}"/>
        </Style>
        <Style Selector="ListBox.surfaceList ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BorderColorMuted}"/>
        </Style>
        <Style Selector="ListBox.surfaceList ListBoxItem:selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
        </Style>
        <Style Selector="ListBox.surfaceList ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSurfaceColor}"/>
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <!-- Every group of choices (Fit, Fill, Stretch and so on) is drawn as a row of chips. -->
        <DataTemplate DataType="vm:Choice" x:DataType="vm:Choice">
            <Button Classes="chip" Classes.active="{Binding IsSelected}" Content="{Binding Label}" Command="{Binding SelectCommand}"/>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid ColumnDefinitions="320,*,284">

        <!-- Settings -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
            <ScrollViewer>
                <StackPanel Margin="14" Spacing="12">

                    <!-- Source -->
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{loc:L StudioSourceHeader}" Classes="eyebrow"/>

                            <StackPanel Spacing="10" IsVisible="{Binding HasImage}">
                                <Grid ColumnDefinitions="72,*">
                                    <Border Width="72" Height="54" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource StageColor}"
                                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                        <Image Source="{Binding Image}" Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding ImageName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ImageInfo}" Classes="muted" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="secondaryButton small" Click="OnBrowseClick" IsVisible="{Binding !IsTextSource}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <iconPacks:PackIconPhosphorIcons Kind="FolderOpen" Width="14" Height="14"/>
                                            <TextBlock Text="{loc:L Replace}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="secondaryButton small" Command="{Binding ClearImageCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <iconPacks:PackIconPhosphorIcons Kind="Trash" Width="14" Height="14"/>
                                            <TextBlock Text="{loc:L Remove}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <ItemsControl Classes="chips" ItemsSource="{Binding SourceChoices.Choices}"/>

                            <!-- A file -->
                            <StackPanel Spacing="8" IsVisible="{Binding IsPictureSource}">
                                <Grid Height="130" IsVisible="{Binding NoImage}">
                                    <Rectangle Stroke="{DynamicResource AccentColor}" StrokeThickness="1.5"
                                               StrokeDashArray="4,4" RadiusX="10" RadiusY="10" Opacity="0.6"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                        <iconPacks:PackIconPhosphorIcons Kind="UploadSimple" Width="30" Height="30"
                                                                         Foreground="{DynamicResource AccentColor}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{loc:L StudioDropHere}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <Button Classes="secondaryButton" Click="OnBrowseClick" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <iconPacks:PackIconPhosphorIcons Kind="FolderOpen" Width="16" Height="16"/>
                                                <TextBlock Text="{loc:L Browse}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{loc:L StudioPictureNote}"
                                           Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- A web link -->
                            <StackPanel Spacing="8" IsVisible="{Binding IsLinkSource}">
                                <TextBox Text="{Binding LinkText}" PlaceholderText="{loc:L StudioLinkPlaceholder}" KeyDown="OnLinkKeyDown"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Classes="accentButton small" Command="{Binding LoadLinkCommand}" Content="{loc:L Load}"/>
                                    <TextBlock Text="{loc:L Loading}" Classes="muted" FontSize="12" VerticalAlignment="Center"
                                               IsVisible="{Binding IsLoadingLink}"/>
                                </StackPanel>
                                <TextBlock Text="{loc:L StudioLinkNote}"
                                           Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Typed text -->
                            <StackPanel Spacing="8" IsVisible="{Binding IsTextSource}">
                                <TextBox Text="{Binding Text}" PlaceholderText="{loc:L StudioTextPlaceholder}" AcceptsReturn="True"
                                         TextWrapping="Wrap" MinHeight="70" MaxHeight="140"/>
                                <TextBlock Text="{loc:L StudioTextLetters}" Classes="fieldLabel"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <ColorPicker IsAlphaEnabled="False" IsAlphaVisible="False" Color="{Binding TextColorValue}"/>
                                    <TextBlock Text="{Binding TextColorHex}" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                                <ItemsControl Classes="chips" ItemsSource="{Binding TextWeightChoices.Choices}"/>
                                <TextBlock Text="{loc:L StudioBackground}" Classes="fieldLabel"/>
                                <ItemsControl Classes="chips" ItemsSource="{Binding TextBackgroundChoices.Choices}"/>
                                <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsTextBackgroundSolid}">
                                    <ColorPicker IsAlphaEnabled="False" IsAlphaVisible="False" Color="{Binding TextBackgroundValue}"/>
                                    <TextBlock Text="{Binding TextBackgroundHex}" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Text="{loc:L StudioTextClearBackgroundNote}"
                                           Classes="muted" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding !IsTextBackgroundSolid}"/>
                            </StackPanel>

                            <TextBlock Text="{Binding ErrorText}" IsVisible="{Binding HasError}"
                                       Foreground="{DynamicResource DangerColor}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Placement -->
                    <Border Classes="card" IsVisible="{Binding HasImage}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{loc:L StudioPlacementHeader}" Classes="eyebrow"/>
                            <ItemsControl Classes="chips" ItemsSource="{Binding PlacementChoices.Choices}"/>

                            <StackPanel Spacing="0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{loc:L StudioZoom}" Classes="fieldLabel"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ZoomText}" FontSize="11"/>
                                </Grid>
                                <Slider Minimum="0.25" Maximum="4" SmallChange="0.05" LargeChange="0.25" Value="{Binding Zoom}"/>
                            </StackPanel>
                            <StackPanel Spacing="0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{loc:L StudioMoveSideways}" Classes="fieldLabel"/>
                                    <TextBlock Grid.Column="1" Text="{Binding OffsetXText}" FontSize="11"/>
                                </Grid>
                                <Slider Minimum="-100" Maximum="100" Value="{Binding OffsetX}"/>
                            </StackPanel>
                            <StackPanel Spacing="0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{loc:L StudioMoveUpDown}" Classes="fieldLabel"/>
                                    <TextBlock Grid.Column="1" Text="{Binding OffsetYText}" FontSize="11"/>
                                </Grid>
                                <Slider Minimum="-100" Maximum="100" Value="{Binding OffsetY}"/>
                            </StackPanel>

                            <WrapPanel>
                                <Button Classes="secondaryButton small" Command="{Binding RotateCommand}" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <iconPacks:PackIconPhosphorIcons Kind="ArrowClockwise" Width="14" Height="14"/>
                                        <TextBlock Text="{loc:L StudioRotate}"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="secondaryButton small" Command="{Binding FlipHorizontalCommand}" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <iconPacks:PackIconPhosphorIcons Kind="FlipHorizontal" Width="14" Height="14"/>
                                        <TextBlock Text="{loc:L StudioFlip}"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="secondaryButton small" Command="{Binding FlipVerticalCommand}" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <iconPacks:PackIconPhosphorIcons Kind="FlipVertical" Width="14" Height="14"/>
                                        <TextBlock Text="{loc:L StudioFlip}"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="secondaryButton small" Command="{Binding ResetPlacementCommand}" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <iconPacks:PackIconPhosphorIcons Kind="ArrowCounterClockwise" Width="14" Height="14"/>
                                        <TextBlock Text="{loc:L Reset}"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Color -->
                    <Border Classes="card" IsVisible="{Binding HasImage}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{loc:L StudioColorHeader}" Classes="eyebrow"/>
                            <ItemsControl Classes="chips" ItemsSource="{Binding ColorModeChoices.Choices}"/>

                            <StackPanel Spacing="0" IsVisible="{Binding IsFreeMode}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{loc:L StudioNumberOfColors}" Classes="fieldLabel"/>
                                    <TextBlock Grid.Column="1" Text="{Binding MaxColorsText}" FontSize="11"/>
                                </Grid>
                                <Slider Minimum="2" Maximum="256" Value="{Binding MaxColors}"/>
                                <TextBlock Text="{loc:L StudioColorsNote}"
                                           Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>

                            <CheckBox Content="{loc:L StudioFillBackground}" IsChecked="{Binding FillBackground}" FontSize="12"/>
                            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding FillBackground}">
                                <ColorPicker IsAlphaEnabled="False" IsAlphaVisible="False" Color="{Binding BackgroundValue}"/>
                                <TextBlock Text="{Binding BackgroundHex}" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>

                            <TextBlock Text="{loc:L StudioDithering}" Classes="fieldLabel"/>
                            <ItemsControl Classes="chips" ItemsSource="{Binding DitheringChoices.Choices}"/>

                            <TextBlock Text="{loc:L StudioFilter}" Classes="fieldLabel"/>
                            <ItemsControl Classes="chips" ItemsSource="{Binding FilterChoices.Choices}"/>

                            <StackPanel Spacing="0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{loc:L StudioBrightness}" Classes="fieldLabel"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BrightnessText}" FontSize="11"/>
                                </Grid>
                                <Slider Minimum="-100" Maximum="100" Value="{Binding Brightness}"/>
                            </StackPanel>
                            <StackPanel Spacing="0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{loc:L StudioContrast}" Classes="fieldLabel"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ContrastText}" FontSize="11"/>
                                </Grid>
                                <Slider Minimum="-100" Maximum="100" Value="{Binding Contrast}"/>
                            </StackPanel>
                            <StackPanel Spacing="0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{loc:L StudioSaturation}" Classes="fieldLabel"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SaturationText}" FontSize="11"/>
                                </Grid>
                                <Slider Minimum="-100" Maximum="100" Value="{Binding Saturation}"/>
                            </StackPanel>

                            <Button Classes="secondaryButton small" Command="{Binding ResetAdjustmentsCommand}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <iconPacks:PackIconPhosphorIcons Kind="ArrowCounterClockwise" Width="14" Height="14"/>
                                    <TextBlock Text="{loc:L Reset}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Quality -->
                    <Border Classes="card" IsVisible="{Binding HasImage}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{loc:L StudioQualityHeader}" Classes="eyebrow"/>
                            <TextBlock Text="{loc:L StudioQualitySizeNote}"
                                       Classes="muted" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding IsSizeSurface}"/>
                            <ItemsControl Classes="chips" ItemsSource="{Binding QualityChoices.Choices}" IsVisible="{Binding IsSizeSurface}"/>
                            <TextBlock Text="{loc:L StudioQualityNeonNote}"
                                       Classes="muted" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding IsPresetSurface}"/>
                            <ItemsControl Classes="chips" ItemsSource="{Binding PresetChoices.Choices}" IsVisible="{Binding IsPresetSurface}"/>
                            <TextBlock Text="{Binding GridText}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:L StudioTextureEstimated}"
                                       IsVisible="{Binding IsTextureEstimated}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Preview -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
            <Border Grid.Row="0" Padding="16,12" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedSurface.Name}" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="{Binding CanvasText}" Classes="muted" FontSize="12"/>
                        <TextBlock Text="{Binding ScrollHint}" IsVisible="{Binding HasScrollHint}"
                                   Foreground="{DynamicResource AccentColor}" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" IsVisible="{Binding HasImage}">
                        <ItemsControl Classes="chips" ItemsSource="{Binding PreviewChoices.Choices}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SaveStatus}" IsVisible="{Binding HasSaveStatus}" Classes="muted" FontSize="12"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                        <Button Classes="secondaryButton" Command="{Binding SaveCommand}" VerticalAlignment="Center" Padding="12,7"
                                ToolTip.Tip="{loc:L StudioSaveTooltip}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <iconPacks:PackIconPhosphorIcons Kind="FloppyDisk" Width="16" Height="16"/>
                                <TextBlock Text="{loc:L Save}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="accentButton" Command="{Binding PaintCommand}" VerticalAlignment="Center" Padding="14,7">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <iconPacks:PackIconPhosphorIcons Kind="PaintBrush" Width="16" Height="16"/>
                                <TextBlock Text="{loc:L Paint}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" ItemSpacing="8" LineSpacing="8" Margin="0,10,0,0" IsVisible="{Binding IsAnimatedSurface}">
                        <TextBlock Text="{loc:L StudioFramesHeader}" Classes="eyebrow" VerticalAlignment="Center"/>
                        <ItemsControl Classes="chips" ItemsSource="{Binding FrameChips}" VerticalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FrameChip">
                                    <Button Classes="chip" Classes.active="{Binding IsSelected}" Content="{Binding Number}" Command="{Binding SelectCommand}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="secondaryButton" Command="{Binding AddFrameCommand}" Padding="8,5" VerticalAlignment="Center"
                                ToolTip.Tip="{loc:L FramesAdd}">
                            <iconPacks:PackIconPhosphorIcons Kind="Plus" Width="14" Height="14"/>
                        </Button>
                        <Button Classes="secondaryButton" Command="{Binding RemoveFrameCommand}" Padding="8,5" VerticalAlignment="Center"
                                ToolTip.Tip="{loc:L FramesRemove}">
                            <iconPacks:PackIconPhosphorIcons Kind="Minus" Width="14" Height="14"/>
                        </Button>
                        <Button Classes="secondaryButton" Command="{Binding PlayCommand}" Padding="10,5" VerticalAlignment="Center"
                                ToolTip.Tip="{loc:L StudioFramesSpeedNote}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <iconPacks:PackIconPhosphorIcons Kind="Play" Width="14" Height="14" IsVisible="{Binding !IsPlaying}"/>
                                <iconPacks:PackIconPhosphorIcons Kind="Stop" Width="14" Height="14" IsVisible="{Binding IsPlaying}"/>
                                <TextBlock Text="{Binding PlayText}"/>
                            </StackPanel>
                        </Button>
                        <ItemsControl Classes="chips" ItemsSource="{Binding SpeedChoices.Choices}" VerticalAlignment="Center"/>
                </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{DynamicResource StageColor}">
                <Grid>
                    <Viewbox Stretch="Uniform" Margin="40">
                        <Border x:Name="Stage" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" ClipToBounds="True"
                                Background="{DynamicResource BorderColor}" CornerRadius="4"
                                Cursor="SizeAll" IsHitTestVisible="{Binding HasImage}"
                                PointerPressed="OnStagePressed" PointerMoved="OnStageMoved" PointerReleased="OnStageReleased"
                                PointerCaptureLost="OnStageCaptureLost" PointerWheelChanged="OnStageWheel" DoubleTapped="OnStageDoubleTapped">
                            <Grid>
                                <Image x:Name="PreviewImage" Source="{Binding ShownPreview}" Stretch="Fill" IsVisible="{Binding ShowResult}"
                                       RenderOptions.BitmapInterpolationMode="None"/>
                                <Image Source="{Binding Image}" Stretch="Uniform" IsVisible="{Binding ShowOriginal}"/>

                                <!-- Split view: the placed picture over the left of the divider, so both sides line up. -->
                                <Border Width="{Binding SplitWidth}" HorizontalAlignment="Left" ClipToBounds="True" Background="{DynamicResource BorderColor}"
                                        IsVisible="{Binding ShowSplit}" IsHitTestVisible="False">
                                    <Image x:Name="ReferenceImage" Source="{Binding Reference}" Width="{Binding CanvasWidth}"
                                           HorizontalAlignment="Left" Stretch="Fill"/>
                                </Border>
                                <Border Width="{Binding SplitWidth}" HorizontalAlignment="Left" IsVisible="{Binding ShowSplit}">
                                    <Panel>
                                        <Border x:Name="SplitStrip" Width="34" HorizontalAlignment="Right" Margin="0,0,-17,0"
                                                Background="Transparent" Cursor="SizeWestEast"
                                                PointerPressed="OnSplitPressed" PointerMoved="OnSplitMoved" PointerReleased="OnSplitReleased"
                                                PointerCaptureLost="OnSplitCaptureLost">
                                            <Panel>
                                                <Border x:Name="SplitLine" Width="2" Background="White" HorizontalAlignment="Center"
                                                        IsHitTestVisible="False" BoxShadow="0 0 6 0 #80000000"/>
                                                <Border x:Name="SplitHandle" Width="34" Height="34" CornerRadius="17" Background="White"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                                        BoxShadow="0 1 6 0 #80000000">
                                                    <iconPacks:PackIconPhosphorIcons Kind="ArrowsLeftRight" Width="18" Height="18" Foreground="Black"
                                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Panel>
                                        </Border>
                                        <Border x:Name="PictureLabel" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10"
                                                Padding="7,3" Background="#AA000000" CornerRadius="6" IsHitTestVisible="False">
                                            <TextBlock Text="{loc:L Picture}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                        </Border>
                                    </Panel>
                                </Border>
                                <Border x:Name="ResultLabel" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
                                        Padding="7,3" Background="#AA000000" CornerRadius="6" IsHitTestVisible="False"
                                        IsVisible="{Binding ShowSplit}">
                                    <TextBlock Text="{loc:L Result}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Viewbox>
                    <!-- Outside the Viewbox so the text keeps its size however big the canvas is. -->
                    <TextBlock Text="{loc:L StudioCanvasHint}" Classes="muted" FontSize="11"
                               IsVisible="{Binding HasImage}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                               Margin="0,0,0,10" IsHitTestVisible="False"/>
                    <TextBlock Text="{loc:L StudioNoPicture}" IsVisible="{Binding NoImage}"
                               Classes="muted" FontSize="14" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <Border IsVisible="{Binding IsBusy}" IsHitTestVisible="False" Background="{DynamicResource OverlayColor}"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="14" Padding="10,6"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,16,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Arc Classes="spinner" Width="14" Height="14" StartAngle="0" SweepAngle="270"
                                 StrokeThickness="2" StrokeLineCap="Round" Stroke="{DynamicResource AccentColor}"/>
                            <TextBlock Text="{loc:L Rendering}" Classes="muted" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="2" Padding="16,10" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
                <WrapPanel>
                    <TextBlock Classes="muted" FontSize="12" Margin="0,0,18,0">
                        <Run Text="{loc:L StudioStatCanvas}"/>
                        <Run Text="{Binding CanvasText}" Foreground="{DynamicResource TextColor}"/>
                    </TextBlock>
                    <TextBlock Classes="muted" FontSize="12" Margin="0,0,18,0" IsVisible="{Binding HasImage}">
                        <Run Text="{loc:L Picture}"/>
                        <Run Text="{Binding ImageInfo}" Foreground="{DynamicResource TextColor}"/>
                    </TextBlock>
                    <TextBlock Classes="muted" FontSize="12" Margin="0,0,18,0" IsVisible="{Binding HasPlan}">
                        <Run Text="{loc:L StudioStatGrid}"/>
                        <Run Text="{Binding GridText}" Foreground="{DynamicResource TextColor}"/>
                    </TextBlock>
                    <TextBlock Classes="muted" FontSize="12" Margin="0,0,18,0" IsVisible="{Binding HasPlan}">
                        <Run Text="{loc:L StudioStatNeeds}"/>
                        <Run Text="{Binding StrokesText}" Foreground="{DynamicResource TextColor}"/>
                    </TextBlock>
                    <TextBlock Classes="muted" FontSize="12" IsVisible="{Binding HasPlan}">
                        <Run Text="{loc:L StudioStatUses}"/>
                        <Run Text="{Binding ColorsText}" Foreground="{DynamicResource TextColor}"/>
                    </TextBlock>
                    <TextBlock Classes="muted" FontSize="12" Margin="18,0,0,0" IsVisible="{Binding HasPlan}">
                        <Run Text="{loc:L StudioStatTime}"/>
                        <Run Text="{Binding TimeText}" Foreground="{DynamicResource TextColor}"/>
                    </TextBlock>
                </WrapPanel>
            </Border>
        </Grid>

        <!-- Surface -->
        <Border Grid.Column="2" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1,0,0,0">
            <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="14">
                <TextBlock Grid.Row="0" Text="{loc:L StudioSurfaceHeader}" Classes="eyebrow" Margin="0,0,0,10"/>

                <ItemsControl Grid.Row="1" Classes="chips" ItemsSource="{Binding Categories}" Margin="0,0,0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryChip">
                            <Button Classes="chip" Classes.active="{Binding IsSelected}" Content="{Binding Label}"
                                    Tag="{Binding Name}" Click="OnCategoryClick"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ListBox Grid.Row="2" Classes="surfaceList" ItemsSource="{Binding VisibleSurfaces}"
                         SelectedItem="{Binding SelectedSurface}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SurfaceOption">
                            <StackPanel Margin="12,10" Spacing="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding SizeText}" Classes="muted" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="3" Spacing="8" Margin="0,12,0,0" IsVisible="{Binding HasPlan}">
                    <TextBlock Text="{loc:L StudioColorsUsedHeader}" Classes="eyebrow"/>
                    <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding UsedColors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ColorChip">
                                    <Border Width="18" Height="18" Margin="0,0,4,4" CornerRadius="4" Background="{Binding Brush}"
                                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" ToolTip.Tip="{Binding Hex}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</UserControl>
