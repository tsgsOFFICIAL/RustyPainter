<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:RustyPainter.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             xmlns:vm="using:RustyPainter.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="RustyPainter.Views.GetReadyView"
             x:DataType="vm:GetReadyViewModel">

    <UserControl.Resources>
        <!-- Sliders in the app accent instead of the Windows accent. -->
        <StaticResource x:Key="SliderTrackValueFill" ResourceKey="AccentColor"/>
        <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="AccentColorHover"/>
        <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="AccentColorHover"/>
        <StaticResource x:Key="SliderThumbBackground" ResourceKey="AccentColor"/>
        <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="AccentColorHover"/>
        <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="AccentColorHover"/>
    </UserControl.Resources>

    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:Choice" x:DataType="vm:Choice">
            <Button Classes="chip" Classes.active="{Binding IsSelected}" Content="{Binding Label}" Command="{Binding SelectCommand}"/>
        </DataTemplate>
    </UserControl.DataTemplates>

    <ScrollViewer>
        <StackPanel MaxWidth="680" Margin="32,28" Spacing="16" HorizontalAlignment="Center">

            <StackPanel Spacing="4">
                <TextBlock Text="{loc:L GetReadyTitle}" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- What will be painted -->
            <Border Classes="card">
                <Grid ColumnDefinitions="*,*,*">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:L GetReadyStrokesHeader}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedColor}"/>
                        <TextBlock Text="{Binding StrokesText}" FontSize="15" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{loc:L GetReadyColorsHeader}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedColor}"/>
                        <TextBlock Text="{Binding ColorsText}" FontSize="15" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock Text="{loc:L GetReadyTimeHeader}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedColor}"/>
                        <TextBlock Text="{Binding TimeText}" FontSize="15" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Checklist -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="{loc:L GetReadyBeforeYouStart}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedColor}"/>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <iconPacks:PackIconPhosphorIcons Kind="CheckCircleFill" Width="18" Height="18"
                                                         Foreground="{DynamicResource SuccessColor}" IsVisible="{Binding IsRustRunning}"/>
                        <iconPacks:PackIconPhosphorIcons Kind="XCircleFill" Width="18" Height="18"
                                                         Foreground="{DynamicResource DangerColor}" IsVisible="{Binding !IsRustRunning}"/>
                        <TextBlock Grid.Column="1" Text="{Binding RustText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <iconPacks:PackIconPhosphorIcons Kind="ArrowCircleRight" Width="18" Height="18"
                                                         Foreground="{DynamicResource AccentColor}"/>
                        <TextBlock Grid.Column="1" Text="{Binding SetupText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <iconPacks:PackIconPhosphorIcons Kind="Keyboard" Width="18" Height="18"
                                                         Foreground="{DynamicResource AccentColor}"/>
                        <TextBlock Grid.Column="1" Text="{Binding KeysLine}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>

                    <TextBlock Text="{Binding HotkeyProblem}" IsVisible="{Binding HasHotkeyProblem}"
                               Foreground="{DynamicResource DangerColor}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Options -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="{loc:L GetReadyOptionsHeader}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedColor}"/>

                    <CheckBox Content="{loc:L GetReadyClearFirst}" IsChecked="{Binding ClearFirst}"/>

                    <CheckBox Content="{loc:L GetReadyShowHologram}" IsChecked="{Binding ShowHologram}"/>

                    <StackPanel Spacing="6" IsVisible="{Binding IsAnimation}">
                        <TextBlock Text="{loc:L GetReadyFrameSpeed}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedColor}"/>
                        <ItemsControl Classes="chips" ItemsSource="{Binding FrameSpeedChoices.Choices}"/>
                    </StackPanel>

                    <StackPanel Spacing="0" IsVisible="{Binding ShowHologram}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{loc:L SettingsPictureStrength}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedColor}"/>
                            <TextBlock Grid.Column="1" Text="{Binding HologramOpacityText}" FontSize="12"/>
                        </Grid>
                        <Slider Minimum="10" Maximum="90" Value="{Binding HologramOpacity}"/>
                    </StackPanel>

                    <StackPanel Spacing="0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{loc:L Speed}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedColor}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SpeedText}" FontSize="12"/>
                        </Grid>
                        <Slider Minimum="1" Maximum="100" Value="{Binding Speed}"/>
                        <TextBlock Text="{loc:L GetReadySpeedNote}"
                                   Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Spacing="0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{loc:L StudioMoveSideways}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedColor}"/>
                            <TextBlock Grid.Column="1" Text="{Binding NudgeXText}" FontSize="12"/>
                        </Grid>
                        <Slider Minimum="-30" Maximum="30" Value="{Binding NudgeX}"/>
                    </StackPanel>

                    <StackPanel Spacing="0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{loc:L StudioMoveUpDown}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedColor}"/>
                            <TextBlock Grid.Column="1" Text="{Binding NudgeYText}" FontSize="12"/>
                        </Grid>
                        <Slider Minimum="-30" Maximum="30" Value="{Binding NudgeY}"/>
                        <TextBlock Text="{loc:L GetReadyNudgeNote}"
                                   Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="secondaryButton" Command="{Binding BackCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <iconPacks:PackIconPhosphorIcons Kind="ArrowLeft" Width="16" Height="16"/>
                        <TextBlock Text="{loc:L BackToStudio}"/>
                    </StackPanel>
                </Button>
                <Button Classes="accentButton" Command="{Binding StartCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <iconPacks:PackIconPhosphorIcons Kind="Play" Width="16" Height="16"/>
                        <TextBlock Text="{loc:L GetReadyStart}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</UserControl>
