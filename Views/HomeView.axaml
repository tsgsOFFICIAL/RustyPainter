<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:RustyPainter.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             xmlns:vm="using:RustyPainter.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
             x:Class="RustyPainter.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="20">

            <StackPanel Spacing="4">
                <TextBlock Text="{loc:L NavHome}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextColor}"/>
                <TextBlock Text="{loc:L HomeTagline}" Classes="muted"/>
            </StackPanel>

            <Border Classes="card" Padding="28" Background="{DynamicResource AccentSurfaceColor}">
                <StackPanel Spacing="14" MaxWidth="520" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:L HomeHeroPrefix}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextColor}"/>
                        <TextBlock Text="{loc:L HomeHeroAccent}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentColor}"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextColor}" Opacity="0.85"
                               Text="{loc:L HomeDescription}"/>
                    <Button Classes="accentButton" HorizontalAlignment="Left" Command="{Binding OpenStudioCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <iconPacks:PackIconPhosphorIcons Kind="PaintBrushBroadFill" Width="16" Height="16"/>
                            <TextBlock Text="{loc:L HomeOpenStudio}" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
