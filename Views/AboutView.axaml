<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:RustyPainter.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             xmlns:vm="using:RustyPainter.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="RustyPainter.Views.AboutView"
             x:DataType="vm:AboutViewModel">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="24" MaxWidth="820" HorizontalAlignment="Left">

            <TextBlock Text="{loc:L NavAbout}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextColor}"/>

            <Border Classes="card">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Image Source="/Assets/App/logo.ico" Width="48" Height="48"/>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="RustyPainter" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextColor}"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{loc:L Version}" Classes="muted" FontSize="12"/>
                                <TextBlock Text="{Binding VersionText}" Classes="muted" FontSize="12"/>
                                <TextBlock Text="·" Classes="muted" FontSize="12"/>
                                <TextBlock Text="{loc:L FooterBy}" Classes="muted" FontSize="12"/>
                                <TextBlock Text="tsgsOFFICIAL" Classes="muted" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{loc:L HomeDescription}" Classes="muted" TextWrapping="Wrap"/>

                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                        <Button Classes="secondaryButton" Command="{Binding ViewChangelogCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <iconPacks:PackIconPhosphorIcons Kind="ListBullets" Width="16" Height="16"/>
                                <TextBlock Text="{loc:L AboutViewChangelog}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="secondaryButton" Command="{Binding CheckForUpdatesCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <iconPacks:PackIconPhosphorIcons Kind="ArrowsClockwise" Width="16" Height="16"/>
                                <TextBlock Text="{loc:L SettingsCheckForUpdates}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock Text="{Binding UpdateStatusText}" IsVisible="{Binding IsUpdateStatusVisible}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- The details worth quoting in a bug report. -->
            <Border Classes="card">
                <StackPanel Spacing="0">
                    <StackPanel Spacing="0" Margin="0,0,0,4">
                        <TextBlock Text="{loc:L AboutInformationTitle}" FontWeight="Bold" Foreground="{DynamicResource TextColor}"/>
                        <TextBlock Text="{loc:L AboutInformationSubtitle}" Classes="muted" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="140,*" Margin="0,14,0,0">
                        <TextBlock Grid.Column="0" Text="{loc:L Version}" Classes="muted" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding VersionText}" FontSize="12" Foreground="{DynamicResource TextColor}" TextWrapping="Wrap"/>
                    </Grid>
                    <Grid ColumnDefinitions="140,*" Margin="0,8,0,0">
                        <TextBlock Grid.Column="0" Text="{loc:L AboutBuildLabel}" Classes="muted" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding BuildText}" FontSize="12" Foreground="{DynamicResource TextColor}" TextWrapping="Wrap"/>
                    </Grid>
                    <Grid ColumnDefinitions="140,*" Margin="0,8,0,0">
                        <TextBlock Grid.Column="0" Text="{loc:L AboutOsLabel}" Classes="muted" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding OsText}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextColor}"/>
                    </Grid>
                    <Grid ColumnDefinitions="140,*" Margin="0,8,0,0">
                        <TextBlock Grid.Column="0" Text="{loc:L AboutLicenseLabel}" Classes="muted" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding LicenseText}" FontSize="12" Foreground="{DynamicResource TextColor}" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="0">
                        <TextBlock Text="{loc:L AboutLinksTitle}" FontWeight="Bold" Foreground="{DynamicResource TextColor}"/>
                        <TextBlock Text="{loc:L AboutLinksSubtitle}" Classes="muted" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                        <Button Classes="secondaryButton" Command="{Binding OpenGitHubCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <iconPacks:PackIconSimpleIcons Kind="GitHub" Width="16" Height="16"/>
                                <TextBlock Text="GitHub"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="secondaryButton" Command="{Binding OpenDiscordCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <iconPacks:PackIconSimpleIcons Kind="Discord" Width="16" Height="16" Foreground="#5865F2"/>
                                <TextBlock Text="Discord"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="secondaryButton" Command="{Binding OpenKofiCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <iconPacks:PackIconPhosphorIcons Kind="CoffeeFill" Width="16" Height="16" Foreground="#FF6433"/>
                                <TextBlock Text="Ko-fi"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
